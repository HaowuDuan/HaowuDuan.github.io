---
import Base from './Base.astro';

interface Chapter {
  title: string;
  slug: string;
  url: string;
  label?: string;
  status?: 'finished' | 'todo';
  sections?: Array<{
    title: string;
    id: string;
    label?: string;
    status?: 'finished' | 'todo';
  }>;
}

interface Props {
  title: string;
  description?: string;
  math?: boolean;
  bookTitle: string;
  bookIndex: string;
  chapters: Chapter[];
  prevChapter?: { title: string; url: string } | null;
  nextChapter?: { title: string; url: string } | null;
  eyebrow?: string;
}

const { title, description, math = false, bookTitle, bookIndex, chapters, prevChapter, nextChapter, eyebrow } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (url: string) => currentPath === url.replace(/\/$/, '');
const chapterIndex = Math.max(0, chapters.findIndex(chapter => isCurrent(chapter.url)));
const currentChapter = chapters[chapterIndex];
---

<Base title={title} description={description} math={math}>
  <div class="page-shell book-layout">
    <aside class="book-sidebar" aria-label={`${bookTitle} chapters`}>
      <h2><a href={bookIndex}>{bookTitle}</a></h2>
      <ol class="chapter-list">
        {chapters.map((chapter, index) => (
          <li>
            <a href={chapter.url} data-status={chapter.status ?? 'finished'} aria-current={isCurrent(chapter.url) ? 'page' : undefined}>
              {chapter.label ?? chapter.title}
            </a>
            {isCurrent(chapter.url) && (chapter.sections?.length ?? 0) > 0 && (
              <ol class="chapter-sublist" data-article-toc>
                {chapter.sections?.map(section => (
                  <li>
                    <a href={`#${section.id}`} data-status={section.status ?? 'finished'}>
                      {section.label ? `${section.label} ` : ''}{section.title}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </aside>

    <div class="note-content">
      <details class="book-mobile-nav">
        <summary>Chapters · {currentChapter?.label ?? currentChapter?.title ?? title}</summary>
        <ol class="chapter-list">
          {chapters.map(chapter => (
            <li>
              <a href={chapter.url} data-status={chapter.status ?? 'finished'} aria-current={isCurrent(chapter.url) ? 'page' : undefined}>
                {chapter.label ?? chapter.title}
              </a>
              {isCurrent(chapter.url) && (chapter.sections?.length ?? 0) > 0 && (
                <ol class="chapter-sublist" data-article-toc>
                  {chapter.sections?.map(section => (
                    <li>
                      <a href={`#${section.id}`} data-status={section.status ?? 'finished'}>
                        {section.label ? `${section.label} ` : ''}{section.title}
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </details>

      <header class="article-header">
        <p class="eyebrow">{eyebrow ?? `${bookTitle} · ${currentChapter?.label ?? currentChapter?.title ?? title}`}</p>
        <h1 class="article-title">{title}</h1>
        {description && <p class="article-deck">{description}</p>}
      </header>

      <article class="prose" data-linked-headings>
        <slot />
      </article>

      <nav class="chapter-footer" aria-label="Chapter navigation">
        {prevChapter ? <a href={prevChapter.url}>&larr; {prevChapter.title}</a> : <span class="disabled">&larr; Previous</span>}
        {nextChapter ? <a href={nextChapter.url}>{nextChapter.title} &rarr;</a> : <span class="disabled chapter-next">Next &rarr;</span>}
      </nav>
    </div>
  </div>
</Base>
