---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  eyebrow: string;
  description: string;
  basePath: string;
  chapters: any[];
}

const { title, eyebrow, description, basePath, chapters } = Astro.props;
---

<Base title={title} description={description}>
  <div class="page-shell data-page">
    <header class="page-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="page-title">{title}</h1>
      <p class="page-description">{description}</p>
    </header>

    {chapters.length === 0 ? (
      <p class="empty-state">No chapters yet.</p>
    ) : (
      <ol class="editorial-list">
        {chapters.map((chapter, index) => (
          <li>
            <span class="date">Chapter {index + 1}</span>
            <div>
              <h3><a href={`${basePath}${chapter.id}/`}>{chapter.data.title}</a></h3>
              {chapter.data.description && <p>{chapter.data.description}</p>}
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>
