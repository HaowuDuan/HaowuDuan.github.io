---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'about', href: '/' },
  { label: 'blog', href: '/blog/' },
  { label: 'publications', href: '/publications/' },
  { label: 'projects', href: '/projects/' },
  { label: 'repositories', href: '/repositories/' },
  { label: 'CV', href: '/cv/' },
];
const notesItems = [
  { label: 'LLM', href: '/llm-book/' },
  { label: 'Diffusion Models', href: '/diffusion-models/' },
  { label: 'Reinforcement Learning', href: '/reinforcement-learning/' },
  { label: 'GPUs', href: '/gpus/' },
];
const isNotesActive = notesItems.some(n => currentPath.startsWith(n.href));
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/"><strong>Haowu</strong> Duan</a>
    <nav class="site-nav" aria-label="Primary navigation">
      {navItems.map(item => (
        <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <details class="notes-menu">
        <summary class:list={[{ active: isNotesActive }]}>notes</summary>
        <div class="notes-menu__items">
          {notesItems.map(item => (
            <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </div>
      </details>
      <button id="theme-toggle" aria-label="Toggle color theme" class="theme-button" title="Toggle color theme">◐</button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    width: min(calc(100% - 3rem), var(--shell));
    min-height: 4.25rem;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    color: var(--ink-strong);
    font-family: var(--reading);
    font-size: 1.08rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand strong { font-weight: 700; }

  .site-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.15rem 1.1rem;
    font-size: 0.9rem;
  }

  .site-nav > a,
  .notes-menu summary {
    color: var(--muted);
    text-decoration: none;
  }

  .site-nav > a:hover,
  .site-nav > a[aria-current='page'],
  .notes-menu summary:hover,
  .notes-menu summary.active {
    color: var(--ink-strong);
    text-decoration: none;
  }

  .site-nav > a[aria-current='page'],
  .notes-menu summary.active {
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.38rem;
  }

  .notes-menu {
    position: relative;
  }

  .notes-menu summary {
    cursor: pointer;
    list-style: none;
  }

  .notes-menu summary::-webkit-details-marker { display: none; }

  .notes-menu summary::after {
    content: ' ▾';
    color: var(--faint);
    font-size: 0.72em;
  }

  .notes-menu[open] summary::after { content: ' ▴'; }

  .notes-menu__items {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.7rem);
    right: 0;
    min-width: 12.5rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--rule);
    background: var(--paper);
  }

  .notes-menu__items a {
    display: block;
    padding: 0.28rem 0;
    color: var(--muted);
    text-decoration: none;
  }

  .notes-menu__items a:hover,
  .notes-menu__items a[aria-current='page'] {
    color: var(--ink-strong);
  }

  .theme-button {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--muted);
    font: inherit;
    line-height: 1;
  }

  .theme-button:hover { color: var(--ink-strong); }

  @media (max-width: 760px) {
    .site-header__inner {
      width: min(calc(100% - 2rem), var(--shell));
      min-height: auto;
      align-items: flex-start;
      flex-direction: column;
      gap: 0.65rem;
      padding-block: 1rem;
    }

    .site-nav {
      justify-content: flex-start;
      gap: 0.25rem 0.9rem;
    }

    .notes-menu__items { right: auto; left: 0; }
  }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('theme', isDark ? 'light' : 'dark');
  });
</script>
