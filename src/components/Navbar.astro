---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'about', href: '/' },
  { label: 'blog', href: '/blog/' },
  { label: 'publications', href: '/publications/' },
  { label: 'projects', href: '/projects/' },
  { label: 'CV', href: '/cv/' },
];
const notesItems = [
  { label: 'LLM', basePath: '/llm-book/', href: '/llm-book/introduction/' },
  { label: 'Diffusion Models', basePath: '/diffusion-models/', href: '/diffusion-models/diffusion-models-and-path-integrals/' },
  { label: 'Reinforcement Learning', basePath: '/reinforcement-learning/', href: '/reinforcement-learning/introduction/' },
  { label: 'GPUs', basePath: '/gpus/', href: '/gpus/cuda/' },
];
const isNotesActive = notesItems.some(item => currentPath.startsWith(item.basePath));
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/"><strong>Haowu</strong> Duan</a>
    <nav class="site-nav" aria-label="Primary navigation">
      {navItems.map(item => (
        <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a href={notesItems[0].href} aria-current={isNotesActive ? 'page' : undefined}>notes</a>
      <button id="theme-toggle" aria-label="Toggle color theme" class="theme-button" title="Toggle color theme">◐</button>
    </nav>
  </div>
  {isNotesActive && (
    <nav class="notes-subnav" aria-label="Note collections">
      <div class="notes-subnav__inner">
        {notesItems.map(item => (
          <a href={item.href} aria-current={currentPath.startsWith(item.basePath) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </div>
    </nav>
  )}
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
    localStorage.setItem('theme', isDark ? 'light' : 'dark');
  });
</script>
