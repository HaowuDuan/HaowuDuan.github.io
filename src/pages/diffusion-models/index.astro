---
import NotesIndex from '../../components/NotesIndex.astro';
import { getNotes } from '../../lib/notes';

const chapters = await getNotes('diffusion-notes');
if (chapters.length > 0) {
  return Astro.redirect(`/diffusion-models/${chapters[0].id}/`);
}
---

<NotesIndex
  title="Diffusion Models"
  eyebrow="Technical notes"
  description="Notes on diffusion models."
  basePath="/diffusion-models/"
  chapters={chapters}
/>
