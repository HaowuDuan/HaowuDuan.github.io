---
import NotesIndex from '../../components/NotesIndex.astro';
import { getNotes } from '../../lib/notes';

const chapters = await getNotes('llm-notes');
if (chapters.length > 0) {
  return Astro.redirect(`/llm-book/${chapters[0].id}/`);
}
---

<NotesIndex
  title="LLM Notes"
  eyebrow="Technical notes"
  description="Notes on large language models from a physics perspective."
  basePath="/llm-book/"
  chapters={chapters}
/>
