---
import Base from '../layouts/Base.astro';
import { formatAuthors, getPublications } from '../lib/bibtex';

const publications = getPublications();
---

<Base title="Publications" description="Research publications by Haowu Duan in high-energy QCD, field theory, and nuclear physics.">
  <div class="page-shell data-page">
    <header class="page-header">
      <p class="eyebrow">Research</p>
      <h1 class="page-title">Publications</h1>
      <p class="page-description">Work on high-energy QCD, small-x evolution, entanglement, and ultraperipheral nuclear collisions.</p>
    </header>

    <ol class="publication-list" reversed>
      {publications.map(publication => (
        <li class="publication-item">
          <div class="publication-meta">
            <span>{publication.year}</span>
            <span>{publication.abbr || publication.journal}{publication.volume && ` ${publication.volume}`}</span>
          </div>
          <div>
            <h2>{publication.title}</h2>
            <p class="publication-authors">{formatAuthors(publication.author)}</p>
            <p class="publication-venue">
              {publication.journal}{publication.volume && ` ${publication.volume}`}{publication.pages && `, ${publication.pages}`}
            </p>
            <div class="publication-links">
              {publication.doi && <a href={`https://doi.org/${publication.doi}`} target="_blank" rel="noopener">DOI</a>}
              {publication.eprint && <a href={`https://arxiv.org/abs/${publication.eprint}`} target="_blank" rel="noopener">arXiv</a>}
              {publication.inspirehep_id && <a href={`https://inspirehep.net/literature/${publication.inspirehep_id}`} target="_blank" rel="noopener">InspireHEP</a>}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>
