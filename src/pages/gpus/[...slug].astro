---
import Book from '../../layouts/Book.astro';
import { getCollection, render } from 'astro:content';
import { getNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const entries = await getCollection('gpu-notes');
  return entries.map(e => ({ params: { slug: e.id }, props: { entry: e } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const sorted = await getNotes('gpu-notes');
const chapters = sorted.map(ch => ({
  title: ch.data.title,
  slug: ch.id,
  url: `/gpus/${ch.id}/`,
  label: ch.data.chapterNumber ? `${ch.data.chapterNumber}. ${ch.data.title}` : ch.data.title,
  status: ch.data.status,
  sections: ch.data.sections,
}));
const idx = sorted.findIndex(ch => ch.id === entry.id);
const prevChapter = idx > 0 ? { title: sorted[idx - 1].data.title, url: `/gpus/${sorted[idx - 1].id}/` } : null;
const nextChapter = idx < sorted.length - 1 ? { title: sorted[idx + 1].data.title, url: `/gpus/${sorted[idx + 1].id}/` } : null;
---

<Book
  title={entry.data.title}
  description={entry.data.description}
  math={entry.data.math}
  bookTitle="GPUs"
  bookIndex="/gpus/"
  chapters={chapters}
  prevChapter={prevChapter}
  nextChapter={nextChapter}
>
  <Content />
</Book>
