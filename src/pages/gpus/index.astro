---
import NotesIndex from '../../components/NotesIndex.astro';
import { getNotes } from '../../lib/notes';

const chapters = await getNotes('gpu-notes');
if (chapters.length > 0) {
  return Astro.redirect(`/gpus/${chapters[0].id}/`);
}
---

<NotesIndex
  title="GPUs"
  eyebrow="Technical notes"
  description="Notes on GPU architecture and programming."
  basePath="/gpus/"
  chapters={chapters}
/>
