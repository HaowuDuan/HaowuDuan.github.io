---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

let posts: any[] = [];
try {
  posts = (await getCollection('blog')).sort((a: any, b: any) => {
    if (a.data.pinned !== b.data.pinned) return a.data.pinned ? -1 : 1;
    return b.data.date.getTime() - a.data.date.getTime();
  });
} catch {}

const allTags = [...new Set(posts.flatMap(post => post.data.tags as string[]))].sort();
---

<Base title="Blog" description="Technical writing on GPU computing, machine learning, and theoretical physics.">
  <div class="page-shell data-page">
    <header class="page-header">
      <p class="eyebrow">Writing</p>
      <h1 class="page-title">Blog</h1>
      <p class="page-description">Technical writing on GPU computing, machine learning, and theoretical physics.</p>
    </header>

    {allTags.length > 0 && (
      <nav class="topic-index" id="tag-filters" aria-label="Filter writing by topic">
        <button type="button" data-tag="all" aria-pressed="true">All writing</button>
        {allTags.map(tag => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
      </nav>
    )}

    {posts.length === 0 ? (
      <p class="empty-state">No posts yet.</p>
    ) : (
      <ol class="editorial-list" id="post-list">
        {posts.map((post: any) => (
          <li data-tags={post.data.tags.join(',')}>
            <time class="date" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
            </time>
            <div>
              <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              {post.data.description && <p>{post.data.description}</p>}
              {post.data.tags.length > 0 && <div class="tags">{post.data.tags.join(' · ')}</div>}
              {post.data.pinned && <div class="tags">Pinned</div>}
            </div>
          </li>
        ))}
      </ol>
    )}
  </div>
</Base>

<style>
  .topic-index button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
  }

  .topic-index button:hover,
  .topic-index button[aria-pressed='true'] {
    color: var(--ink-strong);
    text-decoration: underline;
    text-underline-offset: 0.25rem;
  }
</style>

<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('#tag-filters button')];
  const entries = [...document.querySelectorAll<HTMLElement>('#post-list > li')];

  for (const filter of filters) {
    filter.addEventListener('click', () => {
      const selectedTag = filter.dataset.tag;
      for (const button of filters) button.setAttribute('aria-pressed', String(button === filter));
      for (const entry of entries) {
        const tags = (entry.dataset.tags || '').split(',');
        entry.hidden = selectedTag !== 'all' && !tags.includes(selectedTag || '');
      }
    });
  }
</script>
