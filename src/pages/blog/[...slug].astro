---
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(heading =>
  (heading.depth === 2 || heading.depth === 3) && heading.slug !== 'footnote-label'
);
const showToc = tocHeadings.length >= 3;
---

<Base title={post.data.title} description={post.data.description} math={post.data.math}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class:list={['page-shell', 'article-shell', 'article-layout', 'blog-post', { 'article-layout--single': !showToc }]}>
    <header class="article-header">
      <h1 class="article-title">{post.data.title}</h1>
      {post.data.description && <p class="article-deck">{post.data.description}</p>}
      <p class="article-meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
      </p>
      <p class="article-tags">{post.data.tags.length > 0 ? post.data.tags.join(' · ') : 'Writing'}</p>
    </header>

    {showToc && <TableOfContents headings={tocHeadings} />}

    <article class="prose" data-linked-headings>
      <Content />
    </article>
  </div>
</Base>
