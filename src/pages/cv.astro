---
import Base from '../layouts/Base.astro';
import { getCV } from '../lib/cv';

const cv = getCV();

function formatDate(value: string | number): string {
  const text = String(value);
  const match = text.match(/^(\d{4})-(\d{2})$/);
  if (!match) return text;
  const month = new Intl.DateTimeFormat('en-US', { month: 'short' }).format(new Date(2000, Number(match[2]) - 1, 1));
  return `${month} ${match[1]}`;
}

function formatRange(start: string | number, end: string | number): string {
  const formattedStart = formatDate(start);
  const formattedEnd = formatDate(end);
  return formattedStart === formattedEnd ? formattedStart : `${formattedStart}–${formattedEnd}`;
}
---

<Base title="CV" description={cv.summary}>
  <div class="page-shell data-page">
    <header class="page-header">
      <p class="eyebrow">Curriculum vitae</p>
      <h1 class="page-title">{cv.name}</h1>
      {cv.summary && <p class="page-description">{cv.summary}</p>}
    </header>

    {cv.sections?.Experience && (
      <section class="cv-section" aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
        <ol class="cv-list">
          {cv.sections.Experience.map((entry: any) => (
            <li class="cv-entry">
              <div class="cv-date">{formatRange(entry.start_date, entry.end_date)}</div>
              <div>
                <h3>{entry.position}</h3>
                <p>{entry.company}</p>
                {(entry.summary || entry.location) && <p class="cv-detail">{[entry.summary, entry.location].filter(Boolean).join(' · ')}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {cv.sections?.Education && (
      <section class="cv-section" aria-labelledby="education-heading">
        <h2 id="education-heading">Education</h2>
        <ol class="cv-list">
          {cv.sections.Education.map((entry: any) => (
            <li class="cv-entry">
              <div class="cv-date">{formatRange(entry.start_date, entry.end_date)}</div>
              <div>
                <h3>{entry.studyType} in {entry.area}</h3>
                <p>{entry.institution}</p>
                {entry.location && <p class="cv-detail">{entry.location}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {cv.sections?.Interests && (
      <section class="cv-section" aria-labelledby="interests-heading">
        <h2 id="interests-heading">Research interests</h2>
        <ol class="cv-list">
          {cv.sections.Interests.map((entry: any) => (
            <li class="cv-entry">
              <div class="cv-date">Current</div>
              <div><h3>{entry.name}</h3><p>{entry.keywords}</p></div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {cv.sections?.['Talks and Conferences'] && (
      <section class="cv-section" aria-labelledby="talks-heading">
        <h2 id="talks-heading">Talks and conferences</h2>
        <ol class="cv-list">
          {cv.sections['Talks and Conferences'].map((entry: any) => (
            <li class="cv-entry">
              <div class="cv-date">{formatRange(entry.start_date, entry.end_date)}</div>
              <div>
                <h3>{entry.position}</h3>
                <p>{entry.company}</p>
                {(entry.summary || entry.location) && <p class="cv-detail">{[entry.summary, entry.location].filter(Boolean).join(' · ')}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {cv.sections?.Skills && (
      <section class="cv-section" aria-labelledby="skills-heading">
        <h2 id="skills-heading">Skills</h2>
        <ol class="cv-list">
          {cv.sections.Skills.map((entry: any) => (
            <li class="cv-entry">
              <div class="cv-date">{entry.name}</div>
              <div><h3>{entry.keywords}</h3></div>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</Base>
